APP_NAME="CivicFix"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Caracas

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres-db
DB_PORT=5432
DB_DATABASE=civicfix_db
DB_USERNAME=civicfix_user
DB_PASSWORD=secret_password

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=redis-cache
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@civicfix.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_TOKEN_EXPIRATION=43200

ROUTING_SERVICE_URL=http://fastapi-routing:8000
ROUTING_INTERNAL_TOKEN=change-me-in-production
ROUTING_TIMEOUT=1.5
ROUTING_CIRCUIT_FAILURES=3
ROUTING_CIRCUIT_TTL=30

MINIO_ENDPOINT=http://minio:9000
MINIO_URL=http://localhost:9000
MINIO_KEY=civicfix_minio
MINIO_SECRET=change-me-in-production
MINIO_BUCKET=civicfix-media
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MEDIA_DISK=s3

CIVICFIX_PREFILTER_RADIUS_METERS=15000
CIVICFIX_GEOFENCE_RADIUS_METERS=50
CIVICFIX_SLA_HOURS=72
CIVICFIX_MEDIA_MAX_KB=350

HORIZON_PREFIX=civicfix_horizon:
HORIZON_DOMAIN=
